# Supabase 專案設定
# 可於 Supabase 專案 -> Project Settings -> API 頁面取得
SUPABASE_URL=https://your-project-ref.supabase.co

# ⚠️ Service Role Key 具有完整資料庫存取權限，僅能放在後端伺服器環境變數中，
# 絕對不要放進前端程式碼或提交到版本控制。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 聊天助理改用 OpenAI（選填；沒設定就使用規則版）
OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# AGENT_MODE=rule   # 設成 rule 可強制使用規則版
