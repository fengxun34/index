# 複製成 .env 後填入真實值（.env 已被 .gitignore 擋住，不會上傳 GitHub）

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI：有填，聊天式掛號助理就會用 GPT；沒填或呼叫失敗，會自動退回規則版
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LINE（選填，詳見 README_LINE.md）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_FRIEND_URL=
